# ─────────────────────────────────────────────────────────
# Copy this to .env and fill in your values.
# NEVER commit .env — it contains real credentials.
# In production (Cloud Run), set these as environment
# variables in the Cloud Run service console instead.
# ─────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── At-rest secret encryption (social_accounts cookies, future credentials) ──
# 32-byte (256-bit) key as a 64-char hex string. Used by both
# server/src/lib/encryption.ts and tools/scraper/shared/encryption.py to
# AES-256-GCM-encrypt social_accounts.encrypted_cookies. The two sides
# round-trip byte-for-byte, so the SAME key must be set on every host that
# reads or writes social-account cookies (local dev, Cloud Run, EC2 worker).
# Generate ONCE and reuse forever — rotating it invalidates all stored cookies:
#   openssl rand -hex 32
CRM_ACCOUNT_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32

# ── Email Verification (ZeroBounce) ───────────────────────
ZEROBOUNCE_API_KEY=your-zerobounce-key

# ── Gmail API (OAuth 2.0) ─────────────────────────────────
# Run `node scripts/gmail-auth-setup.js` to generate these.
# Steps:
#   1. Go to https://console.cloud.google.com
#   2. Create a project → Enable Gmail API
#   3. APIs & Services → Credentials → Create OAuth 2.0 Client ID
#      - Application type: Web application
#      - Authorized redirect URI: http://localhost:3333/callback
#   4. Run: node scripts/gmail-auth-setup.js
#   5. Paste the printed values below
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# ── Email Sender Identity ─────────────────────────────────
EMAIL_FROM=your-gmail@gmail.com
EMAIL_FROM_NAME=OptiRate

# ── Email Mode ────────────────────────────────────────────
# "mock" = no real emails sent (safe for dev/staging) [default]
# "gmail" = send via Gmail API using OAuth credentials above
EMAIL_MODE=mock

# ── Test Mode ─────────────────────────────────────────────
# When true, ALL emails are redirected to TEST_EMAIL_ADDRESS.
# Subjects are prefixed with [TEST]. Safe for testing Gmail integration.
EMAIL_TEST_MODE=false
TEST_EMAIL_ADDRESS=your-test-inbox@gmail.com
# Frontend banner indicator — must match EMAIL_TEST_MODE above.
# Also set NEXT_PUBLIC_EMAIL_TEST_MODE in Vercel environment variables.
NEXT_PUBLIC_EMAIL_TEST_MODE=false

# ── Rate Limiting ─────────────────────────────────────────
# Controls send pace to protect domain reputation.
EMAIL_DAILY_CAP=50
EMAIL_HOURLY_CAP=20
EMAIL_MIN_DELAY=30000
EMAIL_MAX_DELAY=90000

# ── Third-Party Email Platform ────────────────────────────
# Replaces direct Gmail sending with a professional outreach platform.
# "none" = use EMAIL_MODE above (direct send)  [default]
# "mock" = mock platform adapter (dev/testing)
# "instantly" = Instantly.ai
# "smartlead" = Smartlead.ai (future)
EMAIL_PLATFORM=none

# Instantly.ai credentials (only needed when EMAIL_PLATFORM=instantly)
INSTANTLY_API_KEY=your-instantly-api-key
INSTANTLY_WEBHOOK_SECRET=your-webhook-secret
# Comma-separated sending accounts configured in Instantly
INSTANTLY_SENDING_ACCOUNTS=sender1@yourdomain.com,sender2@yourdomain.com
# Sync interval in ms (how often to pull stats from platform). Default: 120000 (2 min)
INSTANTLY_SYNC_INTERVAL=120000

# Public URL for webhook callbacks (Instantly sends events here)
# e.g. https://your-app-xyz.run.app
WEBHOOK_BASE_URL=

# ── Scraper ───────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true

# ── ScrapingBee (enrichment + non-Trustpilot scrapers) ─────
# Managed scraping API. Used in two places:
#  1. Fallback tier in the website email enricher when local stealth
#     and proxy tiers fail.
#  2. PRIMARY for TripAdvisor (full pipeline) and Yelp PROFILE pages
#     /biz/<slug> via stealth_proxy=true (75 credits/page). Yelp's
#     /search page is NOT reachable through ScrapingBee (smoke-tested
#     2026-05-18 — every request times out) so Yelp LISTING uses the
#     Yelp Fusion API instead (see YELP_API_KEY below).
# NOT used by Trustpilot scraping (Playwright + stealth handles that).
# Get a key at https://www.scrapingbee.com — leave blank to disable.
SCRAPINGBEE_API_KEY=

# ── Yelp Fusion API (listing for Yelp scrapes) ────────────
# Free at https://docs.developer.yelp.com/ — 5,000 calls/day, no card.
# Yelp listing (business name, rating, phone, review count, address)
# comes from Fusion at zero credit cost. A typical 6-city × 5-page
# fan-out uses ~30 Fusion calls. Profile enrichment still routes
# through ScrapingBee stealth_proxy on /biz/<slug> because that's the
# only Yelp endpoint ScrapingBee can actually reach.
YELP_API_KEY=

# ── Yelp listing source ────────────────────────────────────
# apify (RECOMMENDED — cookieless, runs on Cloud Run and the Linux worker) |
# browser (free headed-browser /search, owner-local-only — this is what the
# code itself defaults to when this var is unset) | relay (residential proxy
# + a human-minted DataDome cookie) | fusion (paid Yelp API, trial expired).
# Set to apify to use the recommended path; leave as browser (or unset) to
# keep the code's own default.
YELP_LISTING_SOURCE=browser
APIFY_YELP_ACTOR=memo23/yelp-scraper
YELP_APIFY_ENRICH_EMAILS=true
YELP_APIFY_OVERFETCH=6
YELP_APIFY_MAX_ITEMS=100
# Whole-job Apify spend guard: max billable items ONE scrape may fetch across
# all its cities. ~$1.40/job at $0.00275/item. This is the only cap on Apify
# spend in the system, so lower it before handing the dashboard to more users.
YELP_APIFY_MAX_ITEMS_PER_JOB=500
YELP_APIFY_USE_CACHE=false
YELP_APIFY_CACHE_DAYS=30
YELP_APIFY_MARKETS=US

# ── Booking.com (short-term-rental hosts) ─────────────────
# Cookieless Apify actor, listing AND published contact data in one call, so
# it runs anywhere APIFY_API_TOKEN does — Cloud Run and the Linux worker
# included. Needs no key of its own beyond that token.
BOOKING_APIFY_ACTOR=corent1robert/booking-pro-host-scraper
# Only professional hosts publish contact details (EU trader-transparency
# rules), so leaving this on is what makes the results contactable at all.
BOOKING_APIFY_ONLY_PRO_HOSTS=true
# OFF so the plugin collapses hosts itself and can count each host's
# properties — the actor's own dedup returns one row per host but no count,
# and the count is what tags an owner-host apart from an agency.
BOOKING_APIFY_DEDUPE_HOSTS=false
# 25 extra searches with varied dates/guest counts. 2-3x more unique hosts for
# 3-5x the runtime and cost — worth it only on a city already proven to yield.
BOOKING_APIFY_MULTI_SEARCH=false
# Over-fetch multiplier: review score, review count and property type are all
# filtered client-side, and collapsing an agency turns N billed rows into one
# lead.
BOOKING_APIFY_OVERFETCH=3
BOOKING_APIFY_MAX_HOTELS=100
# Whole-job spend guard: max billable rows ONE scrape may fetch. ~$2.20/job at
# the listed $5.49/1,000. Like the Yelp guard, this is the only thing capping
# Apify spend once operators can start jobs from the dashboard.
BOOKING_APIFY_MAX_ITEMS_PER_JOB=400
# Unset means every market is allowed; set it to deliberately narrow.
BOOKING_APIFY_MARKETS=

# ── ScrapFly (Tier 5b — enrichment-only) ──────────────────
# Second managed-proxy vendor stacked after ScrapingBee. Different IP pool
# and anti-bot infra (their `asp=true` Anti-Scraping Protection mode is
# designed for Cloudflare/PerimeterX/DataDome bypass), so domains that
# block ScrapingBee's residential ranges often clear ScrapFly. Free tier:
# 1,000 credits/month, permanent. Get a key at https://scrapfly.io —
# leave blank to disable Tier 5b silently.
SCRAPFLY_API_KEY=

# ── Hunter.io (Tier 9 enrichment + Stage 7 verifier) ──────
# Two roles, same key:
#   1. Enrichment Tier 9 — domain-search fallback that aggregates emails
#      from public sources (LinkedIn, news, GitHub). Fires only after
#      Tiers 1.5/2/5/5b/6/7/8 all return null, so consumption is
#      naturally bounded by the count of fully-blocked operator domains.
#   2. Verifier Stage 7 — last-resort tiebreaker invoked only when
#      ZeroBounce AND MillionVerifier both returned `unknown`.
# Cost discipline: free-mailbox domains (gmail/yahoo/...) are skipped
# without burning a credit, and a per-process hourly cap protects
# against burst usage. Free tier is only 50 calls/month — set the
# caps below to taste, or upgrade to Hunter Starter ($34/mo, 500
# calls) before scaling up enrichment volume.
HUNTER_API_KEY=
# Optional caps (defaults: 15 enrichment + 20 verifier per process per hour)
HUNTER_MAX_DOMAIN_SEARCHES_PER_HOUR=15
HUNTER_MAX_CALLS_PER_HOUR=20

# ── Python interpreter ────────────────────────────────────
# Windows dev:  PYTHON_PATH=.venv/Scripts/python.exe
# Linux/Cloud Run: PYTHON_PATH=/usr/bin/python3  (or omit — auto-detected)
PYTHON_PATH=.venv/Scripts/python.exe

# ── API ───────────────────────────────────────────────────
API_SECRET_KEY=generate-a-random-secret-here
PORT=3001

# ── Frontend → API URL (Next.js uses NEXT_PUBLIC_ prefix) ─
# Local dev:    http://localhost:3001
# Production:   https://trustpilot-gateway-3lazv1k9.uc.gateway.dev  (API Gateway — public proxy to Cloud Run)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ── Frontend → API Key ────────────────────────────────────
# Must match API_SECRET_KEY set on Cloud Run
NEXT_PUBLIC_API_SECRET_KEY=your-api-secret-key-here

# ── Frontend → Gemini AI ──────────────────────────────────
# Used by CampaignBuilder to generate email templates with AI.
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# ── Backend → Gemini AI (FB consumer-ask classifier) ──────
# Optional. When set, the Facebook scraper sends each batch of surviving
# post-stubs to Gemini 2.5 Flash for a final consumer-vs-business check
# after the substring filter. Lifts precision from ~33% to ~90%+ for ~$0.01
# per scrape. Falls through silently to substring-only filtering when this
# is unset or the call errors. The Python helper also falls back to
# NEXT_PUBLIC_GEMINI_API_KEY above so a single key works for both paths.
GEMINI_API_KEY=your-gemini-api-key

# ── Colleague-network warmup scheduler ────────────────────
# Parallel to the pool-internal warmup-scheduler.ts. Sends neutral admin-style
# emails from the 9 is_cold_sender accounts to a fixed list of internal colleagues
# (see server/src/services/colleague-warmup/config.ts), per-sender cadence
# 45-50 min, Mon-Fri 3pm-10pm Asia/Manila. ONE preview email per workday goes
# from jhonquillycampilanan@gmail.com to cathylyn@optinetsolutions.com.
# Default: false. Set true for a ~3-week run, then back to false.
#   - jhonquillycampilanan@gmail.com row exists in email_accounts with valid auth
#   - >=1 is_cold_sender=true status=active row in email_accounts
# Does NOT honor EMAIL_SENDING_PAUSED_UNTIL — that flag pauses cold outreach
# campaigns, but warm-up is the reputation rehab that runs DURING those
# incidents. Use COLLEAGUE_WARMUP_ENABLED=false to stop the warm-up loop.
COLLEAGUE_WARMUP_ENABLED=false
# Manila local YYYY-MM-DD that anchors Workday 1 of the volume ramp. Each
# Mon-Fri on or after this date is a workday; daily target per sender =
# 5 (day 1), +1 per workday, capped at 20. Days before this are no-op.
# Sat/Sun are skipped in the workday count.
COLLEAGUE_WARMUP_START_DATE=

# ── Residential proxy (server-side FB / IG scraping) ──────
# Required for FB/IG scrapes that run on Linux hosts (EC2 worker,
# Cloud Run) because FB checkpoints datacenter IPs on sight. Local
# dev runs on Windows ignore these vars and use the operator's home
# IP directly — no point burning paid bandwidth at home.
#
# _open_driver() in tools/scraper/platforms/facebook.py routes all
# Chrome traffic through host:port using a generated auth extension
# (Chrome rejects user:pass@host:port URLs by design). The country
# code in the username/password is auto-swapped to match the
# operator's chosen location (London -> GB, Berlin -> DE, ...).
# Supported username conventions: _area-XX, -region-XX, _country-XX,
# -cc-XX. Set whichever provider's credentials you're using.
#
# Tested providers (any one set works):
#   Proxy Lite: gate-us.proxylite.com:9595, user has _area-XX
#   Proxio:     geo.proxio.cc:16666,         user has -region-XX
#   Enigma:     resi.enigmaproxy.net:12321,  password has _country-XX
RESIDENTIAL_PROXY_HOST=
RESIDENTIAL_PROXY_PORT=
RESIDENTIAL_PROXY_USERNAME=
RESIDENTIAL_PROXY_PASSWORD=
# Force-enable the proxy on local Windows runs too — useful for
# smoke-testing the proxy path before deploy. Defaults false.
RESIDENTIAL_PROXY_FORCE=false

# ── Facebook discovery (Apify) ─────────────────────────────────────
# Apify runs cookieless public-data actors, so FB discovery needs no
# account, has no daily cap, and runs on Cloud Run and Linux workers
# (it opens no browser). Free tier caps the search actor at 20
# results/run + 1 run/24h — a paid plan (~$39/mo) is required for real
# volume. Pricing: $2.59/1,000 results (search actor), $5.00/1,000
# results (group actor). Sign up at https://apify.com — leave the
# token blank to disable Apify discovery entirely (falls back to
# FB_DISCOVERY=browser needing an active social_accounts row instead).
APIFY_API_TOKEN=
# Actor ids verified live 2026-07-31. Required input key is `query`
# (NOT `search_query`) — see workflows/scrape_facebook.md for the full
# input schema per actor.
#
# GROUP MODE IS NON-FUNCTIONAL (live-tested 2026-08-03): the search
# actor with search_type=groups returns 0 items even for a one-word
# query, and data-slayer/facebook-group-posts returns 0 items even for
# its own documented default input. Open-feed post search works fine.
# The code detects the empty result, emits `apify_groups_unavailable`
# and falls back to open feed, so Apify discovery is open-feed in
# practice regardless of the groups_only filter. These ids stay
# swappable so a working group actor can be dropped in later; real
# group-scoped work needs FB_DISCOVERY=browser with an account that
# has joined the groups.
APIFY_FB_SEARCH_ACTOR=scrapeforge/facebook-search-posts
APIFY_FB_GROUP_POSTS_ACTOR=data-slayer/facebook-group-posts
# apify (default) = cookieless Apify actor, no browser, runs anywhere.
# browser = legacy logged-in undetected-chromedriver crawl — required
# ONLY for PRIVATE groups an account has already joined (Apify's
# actors are cookieless and structurally cannot see private content).
FB_DISCOVERY=apify
# stub (default) = build leads straight from the Apify search result,
# no browser, zero social_accounts quota used.
# browser = visit each author's profile for bio/website/email — burns
# account quota; opt in only when a campaign genuinely needs those
# fields.
FB_ENRICH=stub

# ── AdsPower (engagement browser — isolated per-account fingerprints) ──
# NOT a proxy — isolates canvas/WebGL/audio/font/screen fingerprint per
# profile, not IP. Requires the AdsPower DESKTOP CLIENT running on this
# SAME host (Local API is localhost-only) and a PAID AdsPower plan —
# the free tier cannot call the Local API at all.
# AdsPower's own docs say the Local API lives at
# http://local.adspower.net:50325 and that the real address is written
# to %LOCALAPPDATA% — BOTH are wrong. Verified live 2026-07-31: the
# working host was http://local.adspower.com:50325, and the real
# address is written to
# %APPDATA%\adspower_global\cwd_global\source\local_api — read that
# file on your own install to confirm rather than trusting either
# documented default (tools/scraper/adspower_probe.py automates this).
ADSPOWER_API_BASE=http://local.adspower.com:50325
# Only needed when AdsPower's "Security Verification" (Settings ->
# API & MCP in the desktop client) is turned ON. Sent as
# `Authorization: Bearer <key>`. Generating a key is itself a
# PAID-plan feature; turning Security Verification OFF is free.
ADSPOWER_API_KEY=
#
# ADSPOWER_PROFILE_ID is deliberately NOT listed as a variable here —
# do NOT add it to .env. It names ONE AdsPower profile for the FACEBOOK
# browser/engagement path and is process-global, so a value in .env
# makes every Facebook session on the host share that single profile.
# The profile id normally comes from the claimed social_accounts row
# (adspower_profile_id); the env var exists only as a fallback for
# callers with no account row (interactive login, browse worker). Pass
# it inline on the one command that needs it, e.g.
#   ADSPOWER_PROFILE_ID=<id> .venv/Scripts/python.exe -m tools.scraper.run ...
# It is scoped to Facebook only — Instagram sessions ignore it.

# Social scraper persistent browser profiles (Facebook + Instagram). The
# worker injects a per-account dir (C:\fb-profiles\<id> / C:\ig-profiles\<id>)
# when a job carries a social_account_id; set a single-tenant default below
# for local owner smoke runs. The profile holds the logged-in session.
FB_PROFILE_DIR=
IG_PROFILE_DIR=
# Instagram proxy region/city — maps to the residential-proxy country code
# (mirrors FB's location routing). Blank = use the proxy creds' baked-in country.
IG_PROXY_LOCATION=

# --- Ongage ESP (email sending engine - Option A / transactional API) ---
# Sends each rendered email via POST https://api.ongage.com/<ONGAGE_LIST_ID>/api/transactional/send_embed_content
# Auth: single API key in the x-api-key header (Ongage > API Keys). Base is api.ongage.com (NOT .net).
# ONGAGE_SENDING_CONNECTION_ID: an ACTIVE id from GET /<list_id>/api/esp_connections (one per sending domain).
ONGAGE_API_BASE=https://api.ongage.com
ONGAGE_API_KEY=
ONGAGE_LIST_ID=
ONGAGE_SENDING_CONNECTION_ID=
# Sender pool to rotate across (conn_id:from_address:from_name, comma-separated)
ONGAGE_SENDERS=
