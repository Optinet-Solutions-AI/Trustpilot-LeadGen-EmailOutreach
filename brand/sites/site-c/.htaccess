# ===== OptiNet static site: caching + clean URLs (managed) =====
Options -Indexes -MultiViews

# ---- Clean (extensionless) URLs ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /index or /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # /page.html -> /page
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Serve /page from /page.html (only when the .html exists and request isn't a real file/dir)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---- Caching: override inherited no-store, cache static assets hard ----
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|css|js|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Expires
    Header unset Pragma
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
    Header unset Pragma
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>

# ---- Compression (no-op if parent already covers) ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
